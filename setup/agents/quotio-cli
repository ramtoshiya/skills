#!/bin/sh
# Run the command-line helper bundled with the Quotio app.
for app in "/Applications/Quotio.app" "/Applications/Quotio Beta.app"; do
  if [ -x "$app/Contents/Helpers/quotio-cli" ]; then
    exec "$app/Contents/Helpers/quotio-cli" "$@"
  fi
done
echo "quotio-cli: Quotio is not installed in /Applications. Get it from https://github.com/nguyenphutrong/quotio" >&2
exit 127
